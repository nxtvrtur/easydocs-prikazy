Перем Лог;

Процедура Л(Текст)
	Лог.ДобавитьСтроку(Текст);
	Лог.Записать(КаталогВременныхФайлов() + "tz_prikazy_test.log");
КонецПроцедуры

Процедура Кадры(ФИО, Период, Должность, Подразделение)
	Сотрудник = Справочники.Сотрудники.НайтиПоНаименованию(ФИО, Истина);
	Набор = РегистрыСведений.КадроваяИсторияСотрудников.СоздатьНаборЗаписей();
	Набор.Отбор.Сотрудник.Установить(Сотрудник);
	Набор.Отбор.Период.Установить(Период);
	Запись = Набор.Добавить();
	Запись.Период = Период;
	Запись.Сотрудник = Сотрудник;
	Запись.Должность = Должность;
	Запись.Подразделение = Подразделение;
	Набор.Записать();
КонецПроцедуры

Функция КоличествоФайлов(Документ)
	Запрос = Новый Запрос("ВЫБРАТЬ Ссылка, Наименование, Сотрудник, ДанныеФайла ИЗ Справочник.ТЗ_ПрисоединенныеФайлы ГДЕ Документ = &Д");
	Запрос.УстановитьПараметр("Д", Документ);
	Возврат Запрос.Выполнить().Выгрузить();
КонецФункции

Процедура Тест()

	Константы.РуководительОрганизации.Установить("Орлов Сергей Викторович");
	Константы.ДолжностьРуководителя.Установить("Генеральный директор");

	// Должность на дату документа (20.09.2026) отличается от текущей.
	Кадры("Васильев Денис Андреевич", Дата(2026, 1, 10), "Менеджер по продажам", "Отдел продаж");
	Кадры("Васильев Денис Андреевич", Дата(2026, 9, 1), "Руководитель отдела продаж", "Отдел продаж");
	Кадры("Васильев Денис Андреевич", Дата(2026, 10, 1), "Коммерческий директор", "Дирекция");
	Кадры("Кузнецов Олег Игоревич", Дата(2026, 3, 1), "Старший кладовщик", "Склад №1");

	Запрос = Новый Запрос("ВЫБРАТЬ Ссылка, Номер, Проведен ИЗ Документ.Премия УПОРЯДОЧИТЬ ПО Дата");
	Документы_ = Запрос.Выполнить().Выгрузить();
	Документ = Документы_[1].Ссылка;
	Л("Документ: " + Документ);

	Список = Обработки.ТЗ_ПечатьПриказовНаПремию.СотрудникиДокумента(Документ);
	Л("Сотрудников в списке: " + Список.Количество());
	Для Каждого С Из Список Цикл
		Л("  " + С.ФИО + " | " + С.ТабельныйНомер + " | " + С.Должность + " | " + С.Подразделение + " | " + С.Сумма);
	КонецЦикла;

	Непров = Обработки.ТЗ_ПечатьПриказовНаПремию.СотрудникиДокумента(Документы_[2].Ссылка);
	Л("Непроведённый документ, сотрудников: " + Непров.Количество());

	// Отмечены не подряд: Кузнецов (1-я строка документа) и Васильев (3-я и 4-я).
	Отмеченные = Новый Массив;
	Отмеченные.Добавить(Справочники.Сотрудники.НайтиПоНаименованию("Васильев Денис Андреевич", Истина));
	Отмеченные.Добавить(Справочники.Сотрудники.НайтиПоНаименованию("Кузнецов Олег Игоревич", Истина));

	Для Прогон = 1 По 2 Цикл
		Р = Обработки.ТЗ_ПечатьПриказовНаПремию.СформироватьПриказы(Документ, Отмеченные, Истина);
		Л("Прогон " + Прогон + ": форм " + Р.ПечатныеФормы.Количество() + ", не прикреплены " + Р.НеПрикреплены.Количество() + ", ошибка '" + Р.Ошибка + "'");
		Для Каждого Т Из Р.НеПрикреплены Цикл
			Л("  ! " + Т);
		КонецЦикла;
		Для Каждого Ф Из Р.ПечатныеФормы Цикл
			Л("  форма: " + Ф.Заголовок + ", строк " + Ф.ТабличныйДокумент.ВысотаТаблицы);
			Текст = "";
			Для Н = 1 По Ф.ТабличныйДокумент.ВысотаТаблицы Цикл
				СтрокаТ = "";
				Для К = 1 По 5 Цикл
					З = СокрЛП(Ф.ТабличныйДокумент.Область(Н, К).Текст);
					Если З <> "" Тогда
						СтрокаТ = СтрокаТ + З + "  ";
					КонецЕсли;
				КонецЦикла;
				Если СтрокаТ <> "" Тогда
					Л("     " + СтрокаТ);
				КонецЕсли;
			КонецЦикла;
		КонецЦикла;
		Файлы = КоличествоФайлов(Документ);
		Л("  файлов у документа: " + Файлы.Количество());
		Для Каждого Ф Из Файлы Цикл
			Л("    " + Ф.Наименование);
		КонецЦикла;
	КонецЦикла;

	Пустой = Обработки.ТЗ_ПечатьПриказовНаПремию.СформироватьПриказы(Документы_[2].Ссылка, Отмеченные, Истина);
	Л("Непроведённый: ошибка '" + Пустой.Ошибка + "'");

	Лог.Записать(КаталогВременныхФайлов() + "tz_prikazy_test.log");
КонецПроцедуры

Лог = Новый ТекстовыйДокумент;
Попытка
	Тест();
Исключение
	Лог.ДобавитьСтроку("EXCEPTION: " + ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
	Лог.Записать(КаталогВременныхФайлов() + "tz_prikazy_test.log");
КонецПопытки;
ЗавершитьРаботуСистемы(Ложь);

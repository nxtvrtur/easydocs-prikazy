#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	// В выбор попадают только проведенные и не помеченные на удаление документы.
	ПараметрыВыбора = Новый Массив;
	ПараметрыВыбора.Добавить(Новый ПараметрВыбора("Отбор.Проведен", Истина));
	ПараметрыВыбора.Добавить(Новый ПараметрВыбора("Отбор.ПометкаУдаления", Ложь));
	Элементы.Документ.ПараметрыВыбора = Новый ФиксированныйМассив(ПараметрыВыбора);

	// Открытие из формы документа "Премия".
	Если Параметры.Свойство("Документ") И ЗначениеЗаполнено(Параметры.Документ) Тогда
		Документ = Параметры.Документ;
		ЗаполнитьСотрудников();
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура ДокументПриИзменении(Элемент)
	ЗаполнитьСотрудников();
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура Печать(Команда)
	СформироватьИПоказать(Истина);
КонецПроцедуры

&НаКлиенте
Процедура СформироватьPDF(Команда)
	СформироватьИПоказать(Ложь);
КонецПроцедуры

&НаКлиенте
Процедура ОтметитьВсех(Команда)
	УстановитьОтметку(Истина);
КонецПроцедуры

&НаКлиенте
Процедура СнятьОтметку(Команда)
	УстановитьОтметку(Ложь);
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура ЗаполнитьСотрудников()

	Сотрудники.Очистить();
	Если Не ЗначениеЗаполнено(Документ) Тогда
		Возврат;
	КонецЕсли;

	Данные = Обработки.ТЗ_ПечатьПриказовНаПремию.СотрудникиДокумента(Документ);
	Для Каждого СтрокаДанных Из Данные Цикл
		НоваяСтрока = Сотрудники.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаДанных);
		НоваяСтрока.Пометка = Истина;
	КонецЦикла;

КонецПроцедуры

&НаКлиенте
Процедура УстановитьОтметку(Значение)
	Для Каждого Строка Из Сотрудники Цикл
		Строка.Пометка = Значение;
	КонецЦикла;
КонецПроцедуры

// ПоказатьНаЭкране = Ложь - только сформировать и прикрепить PDF, без открытия форм.
&НаКлиенте
Процедура СформироватьИПоказать(ПоказатьНаЭкране)

	Если Не ЗначениеЗаполнено(Документ) Тогда
		ПоказатьПредупреждение(, НСтр("ru = 'Выберите документ ""Премия"".'"));
		Возврат;
	КонецЕсли;

	Отмеченные = Новый Массив;
	Для Каждого Строка Из Сотрудники Цикл
		Если Строка.Пометка Тогда
			Отмеченные.Добавить(Строка.Сотрудник);
		КонецЕсли;
	КонецЦикла;

	Если Отмеченные.Количество() = 0 Тогда
		ПоказатьПредупреждение(, НСтр("ru = 'Отметьте хотя бы одного сотрудника для печати.'"));
		Возврат;
	КонецЕсли;

	// Один серверный вызов на всю пачку сотрудников.
	Результат = СформироватьПриказыНаСервере(Документ, Отмеченные);

	Если ЗначениеЗаполнено(Результат.Ошибка) Тогда
		ПоказатьПредупреждение(, Результат.Ошибка);
		Возврат;
	КонецЕсли;

	// Каждая печатная форма - отдельное окно со своим ключом уникальности.
	Если ПоказатьНаЭкране Тогда
		Для Каждого ПечатнаяФорма Из Результат.ПечатныеФормы Цикл
			ПечатнаяФорма.ТабличныйДокумент.Показать(ПечатнаяФорма.Заголовок, ПечатнаяФорма.Ключ);
		КонецЦикла;
	КонецЕсли;

	Прикреплено = Результат.ПечатныеФормы.Количество() - Результат.НеПрикреплены.Количество();
	Если Результат.НеПрикреплены.Количество() = 0 Тогда
		ПоказатьОповещениеПользователя(НСтр("ru = 'Приказы прикреплены к документу'"), ,
			СтрШаблон(НСтр("ru = 'PDF-файлов: %1'"), Прикреплено));
	Иначе
		Сообщить(СтрШаблон(НСтр("ru = 'Прикреплено PDF: %1 из %2. Не прикреплены:'"),
			Прикреплено, Результат.ПечатныеФормы.Количество()));
		Для Каждого Текст Из Результат.НеПрикреплены Цикл
			Сообщить("  " + Текст);
		КонецЦикла;
	КонецЕсли;

КонецПроцедуры

&НаСервереБезКонтекста
Функция СформироватьПриказыНаСервере(Документ, Отмеченные)
	Возврат Обработки.ТЗ_ПечатьПриказовНаПремию.СформироватьПриказы(Документ, Отмеченные, Истина);
КонецФункции

#КонецОбласти

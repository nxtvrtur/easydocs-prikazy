// Сохраняет PDF приказа на компьютер пользователя.
&НаКлиенте
Процедура ОбработкаКоманды(ПараметрКоманды, ПараметрыВыполненияКоманды)

	Файл = ДанныеФайла(ПараметрКоманды);
	Если Файл = Неопределено Тогда
		ПоказатьПредупреждение(, НСтр("ru = 'У элемента нет данных файла.'"));
		Возврат;
	КонецЕсли;

	НачатьПолучениеФайлаССервера(Файл.Адрес, Файл.Имя);

КонецПроцедуры

&НаСервере
Функция ДанныеФайла(Ссылка)

	Объект = Ссылка.ПолучитьОбъект();
	Данные = Объект.ДанныеФайла.Получить();
	Если ТипЗнч(Данные) <> Тип("ДвоичныеДанные") Тогда
		Возврат Неопределено;
	КонецЕсли;

	Возврат Новый Структура("Адрес, Имя",
		ПоместитьВоВременноеХранилище(Данные, Новый УникальныйИдентификатор), Объект.Наименование);

КонецФункции

// Список PDF-приказов, прикрепленных к документу "Премия" (панель навигации формы документа).
&НаКлиенте
Процедура ОбработкаКоманды(ПараметрКоманды, ПараметрыВыполненияКоманды)

	ОткрытьФорму("Справочник.ТЗ_ПрисоединенныеФайлы.ФормаСписка",
		Новый Структура("Отбор", Новый Структура("Документ", ПараметрКоманды)),
		ПараметрыВыполненияКоманды.Источник,
		ПараметрыВыполненияКоманды.Уникальность,
		ПараметрыВыполненияКоманды.Окно,
		ПараметрыВыполненияКоманды.НавигационнаяСсылка);

КонецПроцедуры
